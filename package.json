{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "post": "node scripts/create-post.js",
    "prebuild": "npm run validate:posts && node scripts/generatePosts.cjs",
    "validate:posts": "node scripts/validatePosts.cjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:pages": "node scripts/checkRenderedPages.mjs",
    "generate": "node scripts/generatePosts.cjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@uiw/react-codemirror": "^4.25.11",
    "dayjs": "^1.11.13",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "next": "^15.3.6",
    "next-auth": "^5.0.0-beta.32",
    "next-mdx-remote": "^6.0.0",
    "octokit": "^5.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-highlight": "^7.0.2",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.3.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/debug": "^4.1.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/unist": "^3.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
